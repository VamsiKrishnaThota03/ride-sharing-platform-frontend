# Copy to .env and restart `npm start` after changing it.
# Backend base URL (no trailing slash). Defaults to http://localhost:5001 in development
# and https://ride-sharing-platform-backend.onrender.com in production builds.
REACT_APP_BACKEND_URL=http://localhost:5001
# Public URL of this frontend, used in shared WhatsApp links (defaults to the current origin).
REACT_APP_FRONTEND_URL=http://localhost:3000
